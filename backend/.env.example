# ============================================================
# TrashTalk Chess - Backend Environment Configuration Example
# 复制本文件为 .env 后填入真实密钥，切勿将 .env 提交至 Git！
# ============================================================

# --- 基础运行配置 ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=["*"]

# --- 超时与容错阈值 (单位: 秒) ---
# 注意：须小于前端 wx.request 超时时间（如前端 8.0s，后端上游 LLM 限制 6.0s）
LLM_REQUEST_TIMEOUT_SEC=6.0
LLM_MAX_RETRIES=0
# 若为 false，当角色对应的 API Key 未配置时返回 HTTP 503 (50300)；若为 true，则降级返回 engine_top1
FALLBACK_ON_UNCONFIGURED_PROVIDER=false

# --- DeepSeek API 配置 ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# --- OpenAI (GPT) API 配置 ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Anthropic (Claude) API 配置 ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
